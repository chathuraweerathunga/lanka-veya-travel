# ---------------------------------------------------------------------------
# Lanka Veya Travel — environment variables
# Copy to .env.local for development. Set the same names in Vercel for
# Preview/Production. Placeholder values only; never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, sitemap,
# email links and auth redirects.
NEXT_PUBLIC_SITE_URL=https://lankaveyatravel.com

# Supabase project (Settings → API). The publishable/anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Legacy name also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_. Used to save validated public form
# submissions, rate limiting, uploads and team invitations.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Legacy name also supported:
# SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend, https://resend.com). If missing, requests are still saved
# and the failure is logged in Admin → Email deliveries for retry.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must use a domain verified in Resend.
EMAIL_FROM="Lanka Veya Travel <bookings@lankaveyatravel.com>"

# Random secret (32+ chars) used to hash visitor IPs for form rate limiting.
# Generate with: openssl rand -base64 32
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Optional: set to "false" to stop search engines indexing a production deploy.
# ALLOW_INDEXING=true

# Optional: Google Search Console "HTML tag" verification code (the content="…"
# value only). Adds <meta name="google-site-verification"> to every page.
# GOOGLE_SITE_VERIFICATION=
